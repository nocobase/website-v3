# 系统与编辑器生成的文件
.DS_Store
Thumbs.db

# 依赖（pnpm 工作区：根目录和各个包下的 node_modules）
node_modules/

# 官网的构建产物（在 homepage/ 下 pnpm build 生成，CI 构建后发布，不提交）和 Astro 的缓存
homepage/dist/
homepage/.astro/
# NocoReach 产品界面截图上传到 static-docs 之前的暂存目录（homepage/scripts/reach-shoot.mjs）
homepage/.reach-shots/

# 文档站的构建产物（pnpm doc:build 生成，CI 构建后发布）和 Astro 的缓存
doc/dist/
doc/.astro/

# CDN 发布脚本的依赖（CI 发布时安装）
scripts/deploy-cdn/node_modules/
