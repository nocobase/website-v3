---
import Icon from '@nocobase/site-shared/Icon.astro';
import { askUi } from '../lib/ask-ui.mjs';
import { getSite } from '../lib/site.mjs';
import '../styles/chat.css';
const { lang, endpoint, siteId } = Astro.props;
const ui = askUi[lang] || askUi.en;
const articles = Object.fromEntries(getSite().pages.filter(p => !p.placeholder).map(p => [p.url, p.title]));
---
<button id="docSelectionAsk" class="doc-selection-ask" type="button" hidden aria-controls="docChat" aria-haspopup="dialog" data-pagefind-ignore><Icon name="sparkles" /><span>{ui.selectionAsk}</span></button>
<dialog class="doc-chat" id="docChat" aria-labelledby="chat-title" data-ask-root data-endpoint={endpoint} data-site-id={siteId} data-lang={lang} data-articles={JSON.stringify(articles)} data-pagefind-ignore>
  <header class="doc-chat-head"><h2 id="chat-title"><Icon name="sparkles" />{ui.title}</h2><button type="button" data-search-open aria-label={ui.search} title={ui.search}><Icon name="search" /></button><button type="button" data-chat-close aria-label={ui.close}><Icon name="x" /></button></header>
  <div class="doc-chat-scroll">
    <div class="doc-chat-welcome" data-chat-welcome>
      <span class="doc-chat-mark"><Icon name="sparkles" /></span>
      <h3>{ui.placeholder}</h3>
      <div class="doc-chat-suggestions">{ui.questions.map(q => <button type="button" data-ask-question={q}><span>{q}</span><Icon name="arrow-up-right" /></button>)}</div>
    </div>
  <div class="doc-chat-messages" role="log" aria-live="polite" aria-relevant="additions text" aria-label={ui.title}></div>
  </div>
  <div class="doc-chat-bottom">
    <p class="doc-chat-hint" id="chat-hint">{ui.hint}</p>
    <div class="doc-chat-quote" data-chat-quote hidden role="group" aria-label={ui.quote}>
      <Icon name="quote" />
      <span class="doc-chat-quote-text" data-quote-text></span>
      <button type="button" data-quote-remove aria-label={ui.removeQuote} title={ui.removeQuote}><Icon name="x" /></button>
    </div>
    <p class="doc-chat-quote-error" data-quote-error role="alert" hidden>{ui.quoteLimit}</p>
    <form class="doc-ask-form" data-ask-form>
      <label class="doc-sr-only" for="chat-question">{ui.label}</label>
      <textarea id="chat-question" name="question" rows="2" maxlength="500" required placeholder={ui.placeholder} aria-describedby="chat-hint"></textarea>
      <div class="doc-ask-toolbar">
        <button type="submit" data-chat-send aria-label={ui.send} title={ui.send}>
          <span data-send-icon><Icon name="arrow-up" /></span>
          <span data-stop-icon hidden><Icon name="square" /></span>
        </button>
      </div>
    </form>
  </div>
</dialog>
<script>
  import '../scripts/ask.js';
</script>
