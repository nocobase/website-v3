---
// 官网所有页面的外壳：head（标题、canonical、hreflang、分享卡片、统计）、共用的导航和页脚、页面正文和页面自己的脚本。内容由 src/lib/site.mjs 的 renderPage() 给出。
// 页面自己的 <style>（正文开头写的，要盖过 site.css）放在 body 开头：Astro 把打包的样式表放在 head 的最后，写在 head 里会排在它前面。
// 样式的顺序：颜色字体变量 → 字体 → 导航页脚 → 官网共用样式，首页再加 home.css（在 pages/index.astro 里引入）。
import '@nocobase/site-shared/styles/tokens.css';
import '@nocobase/site-shared/fonts/fonts.css';
import '@nocobase/site-shared/fonts/inter.css';
import '@nocobase/site-shared/styles/shell.css';
import '../styles/site.css';
import Analytics from '@nocobase/site-shared/Analytics.astro';
import Footer from '@nocobase/site-shared/Footer.astro';
import Header from '@nocobase/site-shared/Header.astro';
import SocialMeta from '@nocobase/site-shared/SocialMeta.astro';
import { ANALYTICS } from '../lib/nav.mjs';

const { page } = Astro.props;
const { qsModal } = page;
---
<!doctype html>
<html lang={page.htmlLang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{page.title}</title>
<meta name="description" content={page.description}>
{page.noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={page.canonical}>}
{page.alternates.map(([h, u]) => <link rel="alternate" hreflang={h} href={u}>)}
<SocialMeta title={page.title} description={page.description} url={page.canonical} image={page.share.image} type={page.share.type} siteName="NocoBase" locale={page.htmlLang} />
<script is:inline set:html={page.inline}></script>
<Analytics {...ANALYTICS} />
<link rel="icon" type="image/png" sizes="32x32" href="https://static-docs.nocobase.com/nocobase-favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="https://static-docs.nocobase.com/nocobase-favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="https://static-docs.nocobase.com/nocobase-apple-touch-icon.png">
</head>
<body data-page={page.pageId || undefined} class={page.band ? 'has-band' : undefined}>
<Fragment set:html={page.style} />
<Header {...page.header}>{page.header.cta && <a slot="action" class="nav-cta" href={page.header.cta.href} set:html={page.header.cta.label} />}</Header>
<main id={page.mainId}><Fragment set:html={page.main} /></main>
<Footer {...page.footer} />
<Fragment set:html={page.after} />
<slot />
<dialog id="qsCoreModal" class="qs-modal" closedby="any" aria-labelledby="qsCoreTitle">
  <div class="qs-mhd">
    <div class="qs-mhd-t">
      <span class="qs-mic" aria-hidden="true"><i data-lucide="blocks"></i></span>
      <div>
        <h1 id="qsCoreTitle">{qsModal.title}</h1>
        <p>{qsModal.desc}</p>
      </div>
    </div>
    <button type="button" class="qs-close" command="close" commandfor="qsCoreModal" aria-label={qsModal.close}>
      <i data-lucide="x"></i>
    </button>
  </div>
  <div class="qs-mbody">
    <div class="qs-prompt-box">
      <p class="qs-prompt" id="qs-modal-prompt">{qsModal.prompt}</p>
    </div>
    <div class="qs-macts">
      <span class="qs-copy">
        <button type="button" class="btn btn-pri qs-btn" command="--copy" commandfor="qs-modal-prompt" data-copied-label={qsModal.copied} data-failed-label={qsModal.failed} autofocus><i data-lucide="copy" class="ic-copy"></i><i data-lucide="check" class="ic-ok"></i><span>{qsModal.copy}</span></button>
        <span class="qs-tip" role="status"></span>
      </span>
      <a class="qs-doc" href={qsModal.docsHref} target="_blank" rel="noopener">{qsModal.label}<i data-lucide="arrow-up-right"></i></a>
    </div>
  </div>
</dialog>
<script>
  import '@nocobase/site-shared/shell.js';
  import '../scripts/lucide.js';
  import '../scripts/live-figs.js';
  import '../scripts/quickstart.js';
</script>
</body>
</html>
