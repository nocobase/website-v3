---
// 访问统计：Google Analytics 4、Microsoft Clarity。每个站点传自己的编号（官网和文档站各有一份配置），缺哪个就不加载哪个。
// 两段都是异步加载外部脚本，不阻塞渲染。
export interface Props { ga4?: string; clarity?: string }
const { ga4, clarity } = Astro.props as Props;
const gtag = ga4 && `window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '${ga4}');`;
const cl = clarity && `(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src='https://www.clarity.ms/tag/'+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,'clarity','script','${clarity}');`;
---
{ga4 && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>}
{gtag && <script is:inline set:html={gtag}></script>}
{cl && <script is:inline set:html={cl}></script>}
